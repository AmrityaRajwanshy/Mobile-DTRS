# ==============================================================================
# Mobile-DTRS Frontend Environment Configuration (Next.js & Vercel)
# ==============================================================================

# 1. Backend API Base URL
# For local development: http://127.0.0.1:8000
# For Vercel production: Set this in Vercel Project Dashboard -> Settings -> Environment Variables
# Point to your deployed FastAPI backend (e.g., on Render, Railway, AWS, Fly.io)
BACKEND_API_URL=http://127.0.0.1:8000
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BACKEND_API_URL=http://127.0.0.1:8000

# 2. RailRadar Live API Key (Optional Client Fallback)
# Can be entered directly in the UI modal or configured here
NEXT_PUBLIC_RAILRADAR_API_KEY=
NEXT_PUBLIC_LIVE_API_KEY=
