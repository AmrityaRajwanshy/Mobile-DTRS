# ==============================================================================
# Mobile-DTRS Backend Engine Environment Configuration
# ==============================================================================

# 1. Real-time Train Tracking Telemetry (RailRadar Live API)
# Accepts LIVE_API_KEY or RAILRADAR_API_KEY
# If left blank, the app operates in offline mode with clear diagnostic notices
LIVE_API_KEY=
RAILRADAR_API_KEY=
RAILRADAR_API_URL=https://api.railradar.in/v1

# 2. Server Network Configuration
PORT=8000
HOST=0.0.0.0

# 3. Cloud Database Connection (Optional Neon PostgreSQL)
# If left blank, runs fully self-contained on local SQLite database WIN.db
POSTGRESQL=
DATABASE_URL=
NEON_URL=
